{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Zmanim Today",
  "theme": "luma",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1E40AF"
  },
  "logo": {
    "light": "/images/Untitleddesign(37).png",
    "dark": "/images/Untitleddesign(37).png",
    "href": "https://zmanimtoday.mintlify.site/"
  },
  "favicon": {
    "light": "/images/favicon-32x32.png",
    "dark": "/images/favicon-32x32.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "home",
              "installation"
            ]
          },
          {
            "group": "Sections",
            "pages": [
              "features/zmanim",
              "features/compass",
              "features/siddur",
              "features/reminders"
            ]
          },
          {
            "group": "Settings & Customization",
            "pages": [
              "settings/location",
              "settings/dashboard",
              "settings/preferences"
            ]
          }
        ]
      },
      {
        "tab": "Help",
        "groups": [
          {
            "group": "Help",
            "pages": [
              "help/faq",
              "help/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Technical",
        "groups": [
          {
            "group": "Technical Reference",
            "pages": [
              "technical/how-it-works",
              "technical/zman-calculations"
            ]
          }
        ]
      }
    ]
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#080D16"
    }
  },
  "navbar": {
    "links": [
      {
        "href": "https://zmanimtoday.base44.app/",
        "label": "Try the app now!"
      }
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Legal",
        "items": [
          {
            "label": "© 2026 Zmanim Today. All rights reserved.",
            "href": "https://zmanimtoday.base44.app/Privacy"
          }
        ]
      }
    ]
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Fraunces",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  }
}
